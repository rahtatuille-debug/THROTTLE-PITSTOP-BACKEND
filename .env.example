# Copy this file to .env and fill in real values. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres
# Local/Docker Compose dev: fill in the fields below.
POSTGRES_DB=throttle_pitstop
POSTGRES_USER=throttle_pitstop
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Managed Postgres (e.g. Neon): set this instead, and it overrides the
# POSTGRES_* fields above. Get this from your Neon project's connection
# details - it already includes sslmode=require, which this app needs.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Production only: extra origins allowed to POST forms (e.g. admin login)
# CSRF_TRUSTED_ORIGINS=https://api.example.com

# Optional, read by start.sh on boot (handy on hosts with no shell):
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=you@example.com
# DJANGO_SUPERUSER_PASSWORD=change-me
# SEED_CATALOG=true

# CORS - your frontend's URL(s), comma separated
CORS_ALLOWED_ORIGINS=http://localhost:3000
